# Read from the view alone, as an app would: each medication entry whatever its status, with its RxNorm code, its status,
# the lifecycle class of that status (rule L1), when it started, the day its prescription was written, when it ended,
# each record's own status and the day it ended, so a stop one record states is shown beside another's "active" whichever
# the entry took, the dosage text each record states with the day its prescription was written where it states one, in
# order of that day and the records stating none last, so a dose changed reads in the order it was written (none when
# no record states one; a record that states a written day and no dosage text is not in it), the text each record's source
# wrote for it, such as a stop reason (none when no record has one), what each record was given for, as
# `pod/My active medications` gives it: "<record> for <entry>, <name>" for a condition (an entry with no name gives
# "<record> for <entry>"), "<record> for <code IRI>" for a code in a listed system and "<record> for <system IRI> <code>"
# for a code in another system, each read from the token after "for " up to the first space, never from the text: a pod
# IRI then "," is a condition entry; otherwise a pod IRI alone is a condition entry with no name, an IRI that is not the
# pod's alone is a code in a listed system, and an IRI followed by a space and more text is a system IRI and its code,
# in code point order of the name or code, then the entry or system, then the
# record (none when no record gives a reason), how many records it joins, and each record with the
# document it was derived from, when that was retrieved, and the hospitals that wrote it and that keep it. A source that states no stop gives no end date: none is
# inferred from a medication's last appearance. The code is the one `pod/My active medications` gives, and the entries
# whose lifecycle is cascade:MedicationActive are the ones it lists. A list holds its values in order, separated by U+001F, which no value holds;
# a value's own parts are ended by ", ".
# The structured dosages each record states are in `structuredDosages`, one item for each dosage, as "<record> dosage <n>",
# n the dosage's number in its source, and then, each introduced by ", " and in this order, what it states: "<frequency> per
# <period> <unit>" (a dosage that states only some of the three has "frequency <frequency>", "period <period> <unit>" or "period
# unit <unit>" in its place), "from <start>" and "until <end>" of its bounds, "route <code IRI>" for each route code in a listed
# system and "route <system IRI> <code>" for each in another, and last "dose <comparator><number as written> <unit>", the unit being
# its text as its source wrote it, else its UCUM code. Each is as the record states it, none computed or rounded, and a time its source
# wrote short of the second is as written. A dosage that states nothing is "<record> dosage <n>" alone. The dose is last because its
# unit text may hold anything but U+001F; a route is read as a reason is, by the token after "route " (a code in another system as
# written). A dosage has one route, and each `route` item is one code a source gave for it: two `route` items are two codes, never two routes.
# Items are in code point order of the record, then by n (none when no record states a dosage). `prescriptionDetails` has one item for each record that states any of its
# intent, course of therapy and dispensing window, as "<record> intent <intent>, course <course>, dispense request valid from
# <start>, dispense request valid until <end>" with the parts it states (none when no record states one).
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?medication ?code ?status ?lifecycle ?started ?written ?ended ?statuses ?dosages ?structuredDosages ?prescriptionDetails
       ?narrativeTexts ?reasons (COUNT(?record) AS ?records) ?entry ?entryLabel ?sources
WHERE {
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT CONCAT(?statusText, "\u001F"); separator=""), "\u001F$", "") AS ?statuses)
    WHERE {
      { SELECT ?entry ?statusText
        WHERE {
          ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
          ?values cascade:valuesOfMember ?member .
          OPTIONAL { ?values cascade:workflowStatus ?memberStatus }
          OPTIONAL { ?values cascade:medicationUseEndDate ?memberEnded }
          BIND (CONCAT(STR(?member), " ", COALESCE(?memberStatus, "with no status"),
                       COALESCE(CONCAT(", ended ", STR(?memberEnded)), "")) AS ?statusText)
        }
        ORDER BY ?entry ?statusText }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT ?dosageText; separator=""), "\u001F$", "") AS ?stated)
    WHERE {
      { SELECT ?entry ?dosageText
        WHERE {
          ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
          ?values cascade:valuesOfMember ?member .
          OPTIONAL { ?values cascade:dosageInstructionText ?memberDosage }
          OPTIONAL { ?values cascade:prescriptionWrittenDate ?memberWritten }
          BIND (IF(BOUND(?memberDosage),
                   CONCAT(STR(?member), " ", ?memberDosage, COALESCE(CONCAT(", written ", STR(?memberWritten)), ""), "\u001F"), "") AS ?dosageText)
          BIND (COALESCE(STR(?memberWritten), "~") AS ?writtenKey)
        }
        ORDER BY ?entry ?writtenKey ?dosageText }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT ?dosageLine; separator=""), "\u001F$", "") AS ?structured)
    WHERE {
      { SELECT ?entry ?dosageLine
        WHERE {
          { ?entry a cascade:PrescribedOrReportedMedication .
            BIND ("" AS ?dosageLine) }
          UNION
          { { SELECT ?dosage (GROUP_CONCAT(DISTINCT ?routePart; separator="") AS ?routes)
              WHERE {
                { SELECT ?dosage ?routePart
                  WHERE {
                    { ?holder cascade:structuredDosage ?dosage .
                      BIND ("" AS ?routePart) }
                    UNION
                    { ?dosage cascade:dosageRouteCode ?route .
                      BIND (CONCAT(", route ", STR(?route)) AS ?routePart)
                      BIND (STR(?route) AS ?routeKey)
                      BIND ("" AS ?routeTail) }
                    UNION
                    { ?dosage cascade:dosageRouteCodeInOtherSystem ?otherRoute .
                      BIND (CONCAT(", route ", STR(DATATYPE(?otherRoute)), " ", STR(?otherRoute)) AS ?routePart)
                      BIND (STR(?otherRoute) AS ?routeKey)
                      BIND (STR(DATATYPE(?otherRoute)) AS ?routeTail) }
                  }
                  ORDER BY ?dosage ?routeKey ?routeTail }
              }
              GROUP BY ?dosage }
            ?entry a cascade:PrescribedOrReportedMedication ;
                   cascade:memberCurrentValues ?values .
            ?values cascade:valuesOfMember ?member ; cascade:structuredDosage ?dosage .
            OPTIONAL { ?dosage cascade:dosageRepeatFrequency ?frequency }
            OPTIONAL { ?dosage cascade:dosageRepeatPeriod ?period }
            OPTIONAL { ?dosage cascade:dosageRepeatPeriodUnit ?periodUnit }
            OPTIONAL { ?dosage cascade:dosageBoundsPeriodStart ?boundsStart }
            OPTIONAL { ?dosage cascade:dosageBoundsPeriodEnd ?boundsEnd }
            OPTIONAL { ?dosage cascade:paddedDateTime ?startPadded .
                       ?startPadded cascade:paddedDateTimeProperty ?startPaddedProperty ; cascade:timeAsWritten ?startWritten
                       FILTER (?startPaddedProperty = cascade:dosageBoundsPeriodStart) }
            OPTIONAL { ?dosage cascade:paddedDateTime ?endPadded .
                       ?endPadded cascade:paddedDateTimeProperty ?endPaddedProperty ; cascade:timeAsWritten ?endWritten
                       FILTER (?endPaddedProperty = cascade:dosageBoundsPeriodEnd) }
            OPTIONAL { ?dosage cascade:dosageDoseQuantity ?dose .
                       ?dose cascade:writtenValue ?doseWritten .
                       OPTIONAL { ?dose cascade:quantityComparator ?doseComparator }
                       OPTIONAL { ?dose cascade:unitText ?doseUnitText }
                       OPTIONAL { ?dose cascade:ucumUnit ?doseUcum } }
            BIND (STRAFTER(STR(?dosage), "-dosage-") AS ?number)
            BIND (STRLEN(?number) AS ?numberLength)
            BIND (BOUND(?frequency) && BOUND(?period) && BOUND(?periodUnit) AS ?timed)
            BIND (IF(?timed, CONCAT(", ", STR(?frequency), " per ", STR(?period), " ", ?periodUnit), "") AS ?timedPart)
            BIND (IF(BOUND(?frequency) && !?timed, CONCAT(", frequency ", STR(?frequency)), "") AS ?frequencyPart)
            BIND (IF(BOUND(?period) && !?timed, CONCAT(", period ", STR(?period), COALESCE(CONCAT(" ", ?periodUnit), "")), "") AS ?periodPart)
            BIND (IF(BOUND(?periodUnit) && !BOUND(?period), CONCAT(", period unit ", ?periodUnit), "") AS ?unitPart)
            BIND (IF(BOUND(?boundsStart) || BOUND(?startWritten), CONCAT(", from ", COALESCE(?startWritten, STR(?boundsStart))), "") AS ?fromPart)
            BIND (IF(BOUND(?boundsEnd) || BOUND(?endWritten), CONCAT(", until ", COALESCE(?endWritten, STR(?boundsEnd))), "") AS ?untilPart)
            BIND (IF(BOUND(?doseWritten),
                     CONCAT(", dose ", COALESCE(?doseComparator, ""), ?doseWritten, COALESCE(CONCAT(" ", COALESCE(?doseUnitText, ?doseUcum)), "")),
                     "") AS ?dosePart)
            BIND (CONCAT(STR(?member), " dosage ", ?number, ?timedPart, ?frequencyPart, ?periodPart, ?unitPart, ?fromPart, ?untilPart,
                         ?routes, ?dosePart, "\u001F") AS ?dosageLine) }
        }
        ORDER BY ?entry ?member ?numberLength ?number }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT ?detailLine; separator=""), "\u001F$", "") AS ?detailed)
    WHERE {
      { SELECT ?entry ?detailLine
        WHERE {
          ?entry a cascade:PrescribedOrReportedMedication ;
                 cascade:memberCurrentValues ?values .
          ?values cascade:valuesOfMember ?member .
          OPTIONAL { ?values cascade:medicationRequestIntent ?memberIntent }
          OPTIONAL { ?values cascade:courseOfTherapyType ?memberCourse }
          OPTIONAL { ?values cascade:dispenseRequestValidityPeriodStart ?memberValidFrom }
          OPTIONAL { ?values cascade:dispenseRequestValidityPeriodEnd ?memberValidUntil }
          OPTIONAL { ?values cascade:paddedDateTime ?validFromPadded .
                     ?validFromPadded cascade:paddedDateTimeProperty ?validFromPaddedProperty ; cascade:timeAsWritten ?validFromWritten
                     FILTER (?validFromPaddedProperty = cascade:dispenseRequestValidityPeriodStart) }
          OPTIONAL { ?values cascade:paddedDateTime ?validUntilPadded .
                     ?validUntilPadded cascade:paddedDateTimeProperty ?validUntilPaddedProperty ; cascade:timeAsWritten ?validUntilWritten
                     FILTER (?validUntilPaddedProperty = cascade:dispenseRequestValidityPeriodEnd) }
          BIND (CONCAT(COALESCE(CONCAT(", intent ", ?memberIntent), ""),
                       COALESCE(CONCAT(", course ", ?memberCourse), ""),
                       IF(BOUND(?memberValidFrom) || BOUND(?validFromWritten),
                          CONCAT(", dispense request valid from ", COALESCE(?validFromWritten, STR(?memberValidFrom))), ""),
                       IF(BOUND(?memberValidUntil) || BOUND(?validUntilWritten),
                          CONCAT(", dispense request valid until ", COALESCE(?validUntilWritten, STR(?memberValidUntil))), "")) AS ?detailParts)
          BIND (IF(?detailParts = "", "", CONCAT(STR(?member), " ", SUBSTR(?detailParts, 3), "\u001F")) AS ?detailLine)
        }
        ORDER BY ?entry ?detailLine }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT ?narrativeLine; separator=""), "\u001F$", "") AS ?said)
    WHERE {
      { SELECT ?entry ?narrativeLine
        WHERE {
          ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
          ?values cascade:valuesOfMember ?member .
          OPTIONAL { ?values cascade:narrativeText ?memberNarrativeText }
          BIND (IF(BOUND(?memberNarrativeText), CONCAT(STR(?member), " ", ?memberNarrativeText, "\u001F"), "") AS ?narrativeLine)
        }
        ORDER BY ?entry ?narrativeLine }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT ?reasonLine; separator=""), "\u001F$", "") AS ?given)
    WHERE {
      { SELECT ?entry ?reasonLine
        WHERE {
          { ?entry a cascade:PrescribedOrReportedMedication .
            BIND ("" AS ?reasonLine) }
          UNION
          { ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
            ?values cascade:valuesOfMember ?member ; cascade:reasonCondition ?conditionRecord .
            ?conditionEntry cascade:entryMember ?conditionRecord .
            OPTIONAL { ?conditionEntry cascade:conditionName ?conditionName }
            BIND (CONCAT(STR(?member), " for ", STR(?conditionEntry), COALESCE(CONCAT(", ", ?conditionName), ""), "\u001F") AS ?reasonLine)
            BIND (COALESCE(?conditionName, "") AS ?reasonKey)
            BIND (STR(?conditionEntry) AS ?reasonTail) }
          UNION
          { ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
            ?values cascade:valuesOfMember ?member ; cascade:reasonCode ?reasonCode .
            BIND (CONCAT(STR(?member), " for ", STR(?reasonCode), "\u001F") AS ?reasonLine)
            BIND (STR(?reasonCode) AS ?reasonKey)
            BIND ("" AS ?reasonTail) }
          UNION
          { ?entry a cascade:PrescribedOrReportedMedication ; cascade:memberCurrentValues ?values .
            ?values cascade:valuesOfMember ?member ; cascade:reasonCodeInOtherSystem ?otherCode .
            BIND (CONCAT(STR(?member), " for ", STR(DATATYPE(?otherCode)), " ", STR(?otherCode), "\u001F") AS ?reasonLine)
            BIND (STR(?otherCode) AS ?reasonKey)
            BIND (STR(DATATYPE(?otherCode)) AS ?reasonTail) }
        }
        ORDER BY ?entry ?reasonKey ?reasonTail ?member }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT CONCAT(?sourceText, "\u001F"); separator=""), "\u001F$", "") AS ?sources)
    WHERE {
      { SELECT ?entry ?sourceText
        WHERE {
          { SELECT ?entry ?sourceRecord ?document ?retrievedOn
                   (REPLACE(GROUP_CONCAT(DISTINCT COALESCE(CONCAT(?hospital, ", "), ""); separator=""), ", $", "") AS ?hospitals)
            WHERE {
              { SELECT ?entry ?sourceRecord ?document ?retrievedOn ?hospital
                WHERE {
                  ?entry a cascade:PrescribedOrReportedMedication ; cascade:entryMember ?sourceRecord .
                  OPTIONAL { ?sourceRecord cascade:currentRevision/prov:wasDerivedFrom ?document .
                             OPTIONAL { ?document pav:retrievedOn ?retrievedOn }
                             OPTIONAL { ?document prov:wasGeneratedBy/prov:qualifiedAssociation ?association .
                                        ?association prov:hadRole ?hospitalRole ; prov:agent ?agent
                                        FILTER (?hospitalRole IN (cascade:AuthorRole, cascade:CustodianRole))
                                        OPTIONAL { ?agent rdfs:label ?agentLabel }
                                        OPTIONAL { ?agent pav:hasCurrentVersion/foaf:name ?agentName }
                                        BIND (CONCAT(IF(?hospitalRole = cascade:AuthorRole, "written by ", "kept by "),
                                                     COALESCE(?agentLabel, ?agentName)) AS ?hospital) } }
                }
                ORDER BY ?entry ?sourceRecord ?document ?hospital }
            }
            GROUP BY ?entry ?sourceRecord ?document ?retrievedOn }
          BIND (CONCAT(STR(?sourceRecord), COALESCE(CONCAT(" from ", STR(?document)), ""),
                       COALESCE(CONCAT(", retrieved ", STR(?retrievedOn)), ""),
                       IF(?hospitals = "", "", CONCAT(", ", ?hospitals))) AS ?sourceText)
        }
        ORDER BY ?entry ?sourceText }
    }
    GROUP BY ?entry }
  {
    SELECT ?entry (COUNT(DISTINCT ?candidate) AS ?candidates) (SAMPLE(?candidate) AS ?only)
    WHERE {
      ?entry a cascade:PrescribedOrReportedMedication .
      OPTIONAL {
        ?entry cascade:rxNormCode ?written .
        BIND (IF(isIRI(?written), ?written, IRI(CONCAT("https://ns.cascadeprotocol.org/codes/rxnorm/", ENCODE_FOR_URI(STR(?written))))) AS ?candidate)
      }
    }
    GROUP BY ?entry
  }
  ?entry a cascade:PrescribedOrReportedMedication ; cascade:drugName ?medication ; cascade:entryMember ?record .
  OPTIONAL { ?entry cascade:userSelectedCode ?chosen }
  OPTIONAL { ?entry cascade:workflowStatus ?status }
  OPTIONAL { ?entry cascade:lifecycle ?lifecycle }
  OPTIONAL { ?entry cascade:medicationUseStartDate ?started }
  OPTIONAL { ?entry cascade:prescriptionWrittenDate ?written }
  OPTIONAL { ?entry cascade:medicationUseEndDate ?ended }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  BIND (IF(?stated = "", ?nothing, ?stated) AS ?dosages)
  BIND (IF(?structured = "", ?nothing, ?structured) AS ?structuredDosages)
  BIND (IF(?detailed = "", ?nothing, ?detailed) AS ?prescriptionDetails)
  BIND (IF(?said = "", ?nothing, ?said) AS ?narrativeTexts)
  BIND (IF(?given = "", ?nothing, ?given) AS ?reasons)
  BIND (COALESCE(IF(STRSTARTS(STR(?chosen), "https://ns.cascadeprotocol.org/codes/rxnorm/"), ?chosen, ?nothing),
                 IF(?candidates = 1, ?only, ?nothing)) AS ?code)
}
GROUP BY ?entry ?medication ?code ?status ?lifecycle ?started ?written ?ended ?statuses ?dosages ?structuredDosages ?prescriptionDetails
         ?narrativeTexts ?reasons ?entryLabel ?sources
ORDER BY ?medication ?entry
