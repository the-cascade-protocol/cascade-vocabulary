# What each entry shows: every value its view states of it and every value its members' current versions state of the
# fields the view shows, each with From, the member whose current version states it, and Lead, whether that member is
# the entry's lead (cascade:leadMember), whose values come first. An entry is what an app shows: one allergy, one
# condition, one vaccination; no merged record is stored, so the view holds each member's current values as a node of
# its own (cascade:memberCurrentValues) and this reads the view alone. The view takes the entry's name and codes from
# its lead, and its status and dates from the members the derivations chose for them (cascade:statusFrom,
# cascade:dateFrom and, for a medication, cascade:medicationUseStartDateFrom, cascade:prescriptionWrittenDateFrom and cascade:dosageFrom, and for an allergy cascade:allergyCategoryFrom and cascade:onsetDateFrom). A
# value no member states, such as the highest criticality among them, has no From.
# A member's values link nodes the view builds, each holding values of its own: a time its source wrote short of the
# second (cascade:paddedDateTime), a reference bound (cascade:referenceRangeLow, cascade:referenceRangeHigh), a
# structured dosage (cascade:structuredDosage) and its dose quantity (cascade:dosageDoseQuantity), a dispensed
# quantity and days' supply (cascade:dispenseQuantity, cascade:dispenseDaysSupply) and why a value is absent
# (cascade:valueAbsentForReason). The link is a row of the member's values, with no Part, and each value the node
# holds is a row with the member's From and Lead and, as Part, the way to the node from the member's values, which a
# reader follows without the node's IRI: the link's local name and, for a kind of which one member holds several, a
# space and what tells them apart (a dosage by its number in its source, as pod/My active medications writes it; a
# padded time by the property it is written for, and a value absent for a reason by the property it is absent for),
# and for a node under a node the same of its link after a slash: `referenceRangeHigh`, `paddedDateTime onsetDate`,
# `structuredDosage 2`, `structuredDosage 2/dosageDoseQuantity`, `valueAbsentForReason onsetDate` and
# `dispenseDaysSupply`. A value is as the view holds it. A node is two links deep at most; the entry's own nodes of
# these kinds repeat its members' and are not shown, nor is any other value named after the entry, which repeats its
# members' too. A later kind of node is one more link in the path of the second UNION branch and, when one member
# holds several of it, one more IF in each of the two chains of IFs that tell them apart, which read the node's name,
# the view having made it of its holder's name, a marker and what tells the node apart.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?entry ?entryLabel ?view ?field ?value ?valueLabel ?from ?fromLabel ?lead ?part
WHERE {
  { GRAPH ?view { ?entry cascade:entryMember [] ; cascade:leadMember ?leader ; cascade:memberCurrentValues ?values .
                  ?values cascade:valuesOfMember ?from ; ?field ?value
                  FILTER (?field != cascade:valuesOfMember) }
    BIND (?from = ?leader AS ?lead)
    OPTIONAL { ?from rdfs:label ?fromLabel }
    OPTIONAL { ?entry rdfs:label ?entryLabel }
    OPTIONAL { ?value rdfs:label ?valueLabel } }
  UNION
  { GRAPH ?view { ?entry cascade:entryMember [] ; cascade:leadMember ?leader ; cascade:memberCurrentValues ?values .
                  ?values cascade:valuesOfMember ?from ;
                          (cascade:paddedDateTime|cascade:referenceRangeLow|cascade:referenceRangeHigh|cascade:structuredDosage|cascade:dosageDoseQuantity
                           |cascade:dispenseQuantity|cascade:dispenseDaysSupply|cascade:valueAbsentForReason)+ ?node .
                  ?holder ?link ?node .
                  FILTER (?link IN (cascade:paddedDateTime, cascade:referenceRangeLow, cascade:referenceRangeHigh, cascade:structuredDosage, cascade:dosageDoseQuantity,
                                    cascade:dispenseQuantity, cascade:dispenseDaysSupply, cascade:valueAbsentForReason))
                  OPTIONAL { ?values ?outer ?holder FILTER (?outer IN (cascade:paddedDateTime, cascade:referenceRangeLow, cascade:referenceRangeHigh, cascade:structuredDosage, cascade:dosageDoseQuantity)) }
                  FILTER (?holder = ?values || BOUND(?outer))
                  ?node ?field ?value }
    BIND (?from = ?leader AS ?lead)
    BIND (CONCAT(IF(BOUND(?outer),
                    CONCAT(STRAFTER(STR(?outer), "#"),
                           IF(?outer = cascade:structuredDosage, CONCAT(" ", STRAFTER(STR(?holder), CONCAT(STR(?values), "-dosage-"))),
                              IF(?outer = cascade:paddedDateTime, CONCAT(" ", STRAFTER(STR(?holder), CONCAT(STR(?values), "-padded-"))), "")),
                           "/"),
                    ""),
                 STRAFTER(STR(?link), "#"),
                 IF(?link = cascade:structuredDosage, CONCAT(" ", STRAFTER(STR(?node), CONCAT(STR(?holder), "-dosage-"))),
                    IF(?link = cascade:paddedDateTime, CONCAT(" ", STRAFTER(STR(?node), CONCAT(STR(?holder), "-padded-"))),
                       IF(?link = cascade:valueAbsentForReason, CONCAT(" ", STRAFTER(STR(?node), CONCAT(STR(?holder), "-absent-"))), "")))) AS ?part)
    OPTIONAL { ?from rdfs:label ?fromLabel }
    OPTIONAL { ?entry rdfs:label ?entryLabel }
    OPTIONAL { ?value rdfs:label ?valueLabel } }
  UNION
  { GRAPH ?view { ?entry cascade:entryMember [] ; ?field ?value
                  FILTER (!STRSTARTS(STR(?value), CONCAT(STR(?entry), "-")))
                  FILTER NOT EXISTS { ?entry cascade:memberCurrentValues ?held . ?held ?field ?value } }
    OPTIONAL { ?entry rdfs:label ?entryLabel }
    OPTIONAL { ?value rdfs:label ?valueLabel } }
}
ORDER BY ?entryLabel ?entry ?field DESC(?lead) STR(?value) ?from ?part
