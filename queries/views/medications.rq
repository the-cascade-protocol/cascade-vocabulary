# Each entry takes the name, every RxNorm code, every NDC code, the code the source chose, the status and end date of the
# member chosen for status, the start of use and the day the prescription was written of the members chosen for each, the
# dosage text of its lead, and every intent a member states, so an entry joining a prescription and a list entry says
# both. It also says the lifecycle class of that status (cascade:lifecycle), so an app reads whether the medication is
# still taken without reading the status. Each member's current values are a node of the view of their own, named after
# the entry and the member, which says the member they came from, with the dosage text that member states and what it
# was given for: each condition's record it names (cascade:reasonCondition) and each code of its reason, whether in a
# system the vocabulary lists (cascade:reasonCode) or in another (cascade:reasonCodeInOtherSystem). An entry whose
# lead states no dosage text shows the one of the member the derivations chose (cascade:dosageFrom): none when no member
# states one. It shows the narrative text of its lead (what the lead's source wrote for it, such as a stop reason), and
# each member's node its own: an entry whose lead states none shows none, and the member that does shows it there. A time its source wrote short of the second keeps the node saying so (cascade:PaddedDateTime), named after
# the entry or the member's values and -padded-, so the view never shows a padded time as exact. Each member's node also
# says the intent, the course of therapy and the start and end of the dispensing window its version states, and each structured
# dosage of its version (cascade:structuredDosage) as a node of the view, named after the member's values and -dosage-
# and the dosage's number, holding its repeat frequency, period and period unit, its bounds, each route code and each in
# another system, and its dose quantity as a node of its own, named after the dosage and -dose-quantity, holding the
# number as typed and as written, its comparator and its units, as lab results' reference bounds do. A dosage that holds
# nothing is still a node, and a bound written short of the second keeps its padded node, named after the dosage. Only
# the members say these: the entry's own dosage is the text of the member cascade:dosageFrom names.
# A value a member's source says it holds none of, and why, keeps the node saying so (cascade:ValueAbsentForReason),
# linked from the member's values, named after them and -absent- and the property's local name and holding the
# property and each reason, so the view never shows a missing value as one nothing said; the entry shows none.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:PrescribedOrReportedMedication ;
    cascade:drugName ?name ;
    cascade:rxNormCode ?code ;
    cascade:ndcCode ?ndc ;
    cascade:userSelectedCode ?selected ;
    cascade:workflowStatus ?status ;
    cascade:lifecycle ?lifecycle ;
    cascade:dosageInstructionText ?dosageInstructionText ;
    cascade:narrativeText ?narrativeText ;
    cascade:medicationUseStartDate ?started ;
    cascade:prescriptionWrittenDate ?written ;
    cascade:medicationUseEndDate ?end ;
    cascade:prescribedOrReported ?intent ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:entryMember ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:drugName ?memberDrugName ;
    cascade:rxNormCode ?memberRxNormCode ;
    cascade:ndcCode ?memberNdcCode ;
    cascade:userSelectedCode ?memberUserSelectedCode ;
    cascade:workflowStatus ?memberWorkflowStatus ;
    cascade:dosageInstructionText ?memberDosage ;
    cascade:narrativeText ?memberNarrativeText ;
    cascade:medicationUseStartDate ?memberMedicationUseStartDate ;
    cascade:prescriptionWrittenDate ?memberPrescriptionWrittenDate ;
    cascade:medicationUseEndDate ?memberMedicationUseEndDate ;
    cascade:prescribedOrReported ?memberPrescribedOrReported ;
    cascade:reasonCondition ?memberReasonCondition ;
    cascade:reasonCode ?memberReasonCode ;
    cascade:reasonCodeInOtherSystem ?memberReasonCodeInOtherSystem ;
    cascade:medicationRequestIntent ?memberMedicationRequestIntent ;
    cascade:courseOfTherapyType ?memberCourseOfTherapyType ;
    cascade:dispenseRequestValidityPeriodStart ?memberDispenseRequestValidityPeriodStart ;
    cascade:dispenseRequestValidityPeriodEnd ?memberDispenseRequestValidityPeriodEnd ;
    cascade:structuredDosage ?memberStructuredDosage .
  ?memberStructuredDosage cascade:dosageRepeatFrequency ?dosageFrequency ;
    cascade:dosageRepeatPeriod ?dosagePeriod ;
    cascade:dosageRepeatPeriodUnit ?dosagePeriodUnit ;
    cascade:dosageBoundsPeriodStart ?dosageBoundsStart ;
    cascade:dosageBoundsPeriodEnd ?dosageBoundsEnd ;
    cascade:dosageRouteCode ?dosageRoute ;
    cascade:dosageRouteCodeInOtherSystem ?dosageRouteInOtherSystem ;
    cascade:dosageDoseQuantity ?memberDoseQuantity ;
    cascade:paddedDateTime ?dosagePadded .
  ?memberDoseQuantity cascade:decimalValue ?doseDecimal ; cascade:writtenValue ?doseWritten ; cascade:quantityComparator ?doseComparator ;
    cascade:ucumUnit ?doseUcum ; cascade:unitText ?doseUnitText .
  ?dosagePadded cascade:paddedDateTimeProperty ?dosagePaddedProperty ; cascade:timeAsWritten ?dosageWritten .
  ?entry cascade:paddedDateTime ?startedPadded .
  ?startedPadded cascade:paddedDateTimeProperty cascade:medicationUseStartDate ; cascade:timeAsWritten ?startedWritten .
  ?entry cascade:paddedDateTime ?writtenPadded .
  ?writtenPadded cascade:paddedDateTimeProperty cascade:prescriptionWrittenDate ; cascade:timeAsWritten ?writtenWritten .
  ?entry cascade:paddedDateTime ?endPadded .
  ?endPadded cascade:paddedDateTimeProperty cascade:medicationUseEndDate ; cascade:timeAsWritten ?endWritten .
  ?memberValues cascade:paddedDateTime ?memberPadded .
  ?memberPadded cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten .
  ?memberValues cascade:valueAbsentForReason ?memberAbsent .
  ?memberAbsent cascade:absentValueProperty ?memberAbsentProperty ; cascade:absentReasonCode ?memberAbsentReason .
}
WHERE {
  { ?record a cascade:PrescribedOrReportedMedication ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:drugName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:rxNormCode ?code }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:ndcCode ?ndc }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:userSelectedCode ?selected }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:dosageInstructionText ?leadDosage }
    OPTIONAL { ?entry cascade:dosageFrom/pav:hasCurrentVersion/cascade:dosageInstructionText ?fromDosage }
    BIND (COALESCE(?leadDosage, ?fromDosage) AS ?dosageInstructionText)
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:narrativeText ?narrativeText }
    OPTIONAL { ?record pav:hasCurrentVersion/cascade:prescribedOrReported ?intent }
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
    OPTIONAL { ?entry cascade:statusLifecycle ?lifecycle }
    OPTIONAL { ?entry cascade:statusFrom/pav:hasCurrentVersion/cascade:medicationUseEndDate ?end }
    OPTIONAL { ?entry cascade:medicationUseStartDateFrom/pav:hasCurrentVersion/cascade:medicationUseStartDate ?started }
    OPTIONAL { ?entry cascade:prescriptionWrittenDateFrom/pav:hasCurrentVersion/cascade:prescriptionWrittenDate ?written }
    OPTIONAL { ?entry cascade:medicationUseStartDateFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?startedPaddedAt .
               ?startedPaddedAt cascade:paddedDateTimeProperty ?startedPaddedProperty ; cascade:timeAsWritten ?startedWritten
               FILTER (?startedPaddedProperty = cascade:medicationUseStartDate) }
    BIND (IF(BOUND(?startedWritten), IRI(CONCAT(STR(?entry), "-padded-medicationUseStartDate")), 1/0) AS ?startedPadded)
    OPTIONAL { ?entry cascade:prescriptionWrittenDateFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?writtenPaddedAt .
               ?writtenPaddedAt cascade:paddedDateTimeProperty ?writtenPaddedProperty ; cascade:timeAsWritten ?writtenWritten
               FILTER (?writtenPaddedProperty = cascade:prescriptionWrittenDate) }
    BIND (IF(BOUND(?writtenWritten), IRI(CONCAT(STR(?entry), "-padded-prescriptionWrittenDate")), 1/0) AS ?writtenPadded)
    OPTIONAL { ?entry cascade:statusFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?endPaddedAt .
               ?endPaddedAt cascade:paddedDateTimeProperty ?endPaddedProperty ; cascade:timeAsWritten ?endWritten
               FILTER (?endPaddedProperty = cascade:medicationUseEndDate) }
    BIND (IF(BOUND(?endWritten), IRI(CONCAT(STR(?entry), "-padded-medicationUseEndDate")), 1/0) AS ?endPadded) }
  UNION
  { ?member a cascade:PrescribedOrReportedMedication ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:drugName ?memberDrugName }
    OPTIONAL { ?memberVersion cascade:rxNormCode ?memberRxNormCode }
    OPTIONAL { ?memberVersion cascade:ndcCode ?memberNdcCode }
    OPTIONAL { ?memberVersion cascade:userSelectedCode ?memberUserSelectedCode }
    OPTIONAL { ?memberVersion cascade:workflowStatus ?memberWorkflowStatus }
    OPTIONAL { ?memberVersion cascade:dosageInstructionText ?memberDosage }
    OPTIONAL { ?memberVersion cascade:narrativeText ?memberNarrativeText }
    OPTIONAL { ?memberVersion cascade:medicationUseStartDate ?memberMedicationUseStartDate }
    OPTIONAL { ?memberVersion cascade:prescriptionWrittenDate ?memberPrescriptionWrittenDate }
    OPTIONAL { ?memberVersion cascade:medicationUseEndDate ?memberMedicationUseEndDate }
    OPTIONAL { ?memberVersion cascade:prescribedOrReported ?memberPrescribedOrReported }
    OPTIONAL { ?memberVersion cascade:reasonCondition ?memberReasonCondition }
    OPTIONAL { ?memberVersion cascade:reasonCode ?memberReasonCode }
    OPTIONAL { ?memberVersion cascade:reasonCodeInOtherSystem ?memberReasonCodeInOtherSystem }
    OPTIONAL { ?memberVersion cascade:medicationRequestIntent ?memberMedicationRequestIntent }
    OPTIONAL { ?memberVersion cascade:courseOfTherapyType ?memberCourseOfTherapyType }
    OPTIONAL { ?memberVersion cascade:dispenseRequestValidityPeriodStart ?memberDispenseRequestValidityPeriodStart }
    OPTIONAL { ?memberVersion cascade:dispenseRequestValidityPeriodEnd ?memberDispenseRequestValidityPeriodEnd }
    OPTIONAL { ?memberVersion cascade:structuredDosage ?dosageAt .
               OPTIONAL { ?dosageAt cascade:dosageRepeatFrequency ?dosageFrequency }
               OPTIONAL { ?dosageAt cascade:dosageRepeatPeriod ?dosagePeriod }
               OPTIONAL { ?dosageAt cascade:dosageRepeatPeriodUnit ?dosagePeriodUnit }
               OPTIONAL { ?dosageAt cascade:dosageBoundsPeriodStart ?dosageBoundsStart }
               OPTIONAL { ?dosageAt cascade:dosageBoundsPeriodEnd ?dosageBoundsEnd }
               OPTIONAL { ?dosageAt cascade:dosageRouteCode ?dosageRoute }
               OPTIONAL { ?dosageAt cascade:dosageRouteCodeInOtherSystem ?dosageRouteInOtherSystem }
               OPTIONAL { ?dosageAt cascade:dosageDoseQuantity ?doseAt .
                          ?doseAt cascade:decimalValue ?doseDecimal ; cascade:writtenValue ?doseWritten .
                          OPTIONAL { ?doseAt cascade:quantityComparator ?doseComparator }
                          OPTIONAL { ?doseAt cascade:ucumUnit ?doseUcum }
                          OPTIONAL { ?doseAt cascade:unitText ?doseUnitText } }
               OPTIONAL { ?dosageAt cascade:paddedDateTime ?dosagePaddedAt .
                          ?dosagePaddedAt cascade:paddedDateTimeProperty ?dosagePaddedProperty ; cascade:timeAsWritten ?dosageWritten } }
    BIND (IF(BOUND(?dosageAt), IRI(CONCAT(STR(?memberValues), "-dosage-", STRAFTER(STR(?dosageAt), "#dosage-"))), 1/0)
          AS ?memberStructuredDosage)
    BIND (IF(BOUND(?doseAt), IRI(CONCAT(STR(?memberStructuredDosage), "-dose-quantity")), 1/0) AS ?memberDoseQuantity)
    BIND (IF(BOUND(?dosageWritten), IRI(CONCAT(STR(?memberStructuredDosage), "-padded-", STRAFTER(STR(?dosagePaddedProperty), "#"))), 1/0)
          AS ?dosagePadded)
    OPTIONAL { ?memberVersion cascade:paddedDateTime ?memberPaddedAt .
               ?memberPaddedAt cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten }
    BIND (IF(BOUND(?memberWritten), IRI(CONCAT(STR(?memberValues), "-padded-", STRAFTER(STR(?memberPaddedProperty), "#"))), 1/0)
          AS ?memberPadded)
    OPTIONAL { ?memberVersion cascade:valueAbsentForReason ?memberAbsentAt .
               ?memberAbsentAt cascade:absentValueProperty ?memberAbsentProperty ; cascade:absentReasonCode ?memberAbsentReason }
    BIND (IF(BOUND(?memberAbsentAt), IRI(CONCAT(STR(?memberValues), "-absent-", STRAFTER(STR(?memberAbsentProperty), "#"))), 1/0)
          AS ?memberAbsent) }
}
