# Each entry takes the vaccine and code of its lead, the status of the member chosen for status, and the date of the
# member chosen for the date. Each member's current values are a node of the view of their own, named after the entry
# and the member, which says the member they came from and what it was given for: each condition's record it names
# (cascade:reasonCondition) and each code of its reason, whether in a system the vocabulary lists (cascade:reasonCode)
# or in another (cascade:reasonCodeInOtherSystem). A time its source wrote short of the second keeps the node
# saying so (cascade:PaddedDateTime), named after the entry or the member's values and -padded-, so the view never shows
# a padded time as exact.
# A value a member's source says it holds none of, and why, keeps the node saying so (cascade:ValueAbsentForReason),
# linked from the member's values, named after them and -absent- and the property's local name and holding the
# property and each reason, so the view never shows a missing value as one nothing said; the entry shows none.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:Vaccination ;
    cascade:vaccineName ?name ;
    cascade:vaccineCode ?code ;
    cascade:workflowStatus ?status ;
    cascade:vaccinationOccurrenceTime ?date ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:entryMember ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:vaccineName ?memberVaccineName ;
    cascade:vaccineCode ?memberVaccineCode ;
    cascade:workflowStatus ?memberWorkflowStatus ;
    cascade:vaccinationOccurrenceTime ?memberVaccinationOccurrenceTime ;
    cascade:reasonCondition ?memberReasonCondition ;
    cascade:reasonCode ?memberReasonCode ;
    cascade:reasonCodeInOtherSystem ?memberReasonCodeInOtherSystem ;
    cascade:vaccineLotNumber ?memberLotNumber ;
    cascade:vaccinationBodySiteText ?memberBodySiteText ;
    cascade:vaccinationRouteText ?memberRouteText ;
    cascade:vaccineDoseQuantityText ?memberDoseQuantityText ;
    cascade:addedNoteText ?memberAddedNoteText .
  ?entry cascade:paddedDateTime ?datePadded .
  ?datePadded cascade:paddedDateTimeProperty cascade:vaccinationOccurrenceTime ; cascade:timeAsWritten ?dateWritten .
  ?memberValues cascade:paddedDateTime ?memberPadded .
  ?memberPadded cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten .
  ?memberValues cascade:valueAbsentForReason ?memberAbsent .
  ?memberAbsent cascade:absentValueProperty ?memberAbsentProperty ; cascade:absentReasonCode ?memberAbsentReason .
}
WHERE {
  { ?record a cascade:Vaccination ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:vaccineName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:vaccineCode ?code }
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:vaccinationOccurrenceTime ?date }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?datePaddedAt .
               ?datePaddedAt cascade:paddedDateTimeProperty ?datePaddedProperty ; cascade:timeAsWritten ?dateWritten
               FILTER (?datePaddedProperty = cascade:vaccinationOccurrenceTime) }
    BIND (IF(BOUND(?dateWritten), IRI(CONCAT(STR(?entry), "-padded-vaccinationOccurrenceTime")), 1/0) AS ?datePadded) }
  UNION
  { ?member a cascade:Vaccination ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:vaccineName ?memberVaccineName }
    OPTIONAL { ?memberVersion cascade:vaccineCode ?memberVaccineCode }
    OPTIONAL { ?memberVersion cascade:workflowStatus ?memberWorkflowStatus }
    OPTIONAL { ?memberVersion cascade:vaccinationOccurrenceTime ?memberVaccinationOccurrenceTime }
    OPTIONAL { ?memberVersion cascade:reasonCondition ?memberReasonCondition }
    OPTIONAL { ?memberVersion cascade:reasonCode ?memberReasonCode }
    OPTIONAL { ?memberVersion cascade:reasonCodeInOtherSystem ?memberReasonCodeInOtherSystem }
    OPTIONAL { ?memberVersion cascade:vaccineLotNumber ?memberLotNumber }
    OPTIONAL { ?memberVersion cascade:vaccinationBodySiteText ?memberBodySiteText }
    OPTIONAL { ?memberVersion cascade:vaccinationRouteText ?memberRouteText }
    OPTIONAL { ?memberVersion cascade:vaccineDoseQuantityText ?memberDoseQuantityText }
    OPTIONAL { ?memberVersion cascade:addedNoteText ?memberAddedNoteText }
    OPTIONAL { ?memberVersion cascade:paddedDateTime ?memberPaddedAt .
               ?memberPaddedAt cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten }
    BIND (IF(BOUND(?memberWritten), IRI(CONCAT(STR(?memberValues), "-padded-", STRAFTER(STR(?memberPaddedProperty), "#"))), 1/0)
          AS ?memberPadded)
    OPTIONAL { ?memberVersion cascade:valueAbsentForReason ?memberAbsentAt .
               ?memberAbsentAt cascade:absentValueProperty ?memberAbsentProperty ; cascade:absentReasonCode ?memberAbsentReason }
    BIND (IF(BOUND(?memberAbsentAt), IRI(CONCAT(STR(?memberValues), "-absent-", STRAFTER(STR(?memberAbsentProperty), "#"))), 1/0)
          AS ?memberAbsent) }
}
