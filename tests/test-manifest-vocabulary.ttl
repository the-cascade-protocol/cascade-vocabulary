@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The terms the query fixtures' manifests add to W3C's mf: and qt: test-manifest vocabularies. No pod uses them.

ctm:lensQueryPath a owl:ObjectProperty ;
    rdfs:label "lens query path"@en ;
    rdfs:comment "The query file of the lens a query test builds its pod under."@en .

ctm:comparesSqlWithSparqlUnderEveryLens a owl:ObjectProperty ;
    rdfs:label "compares SQL with SPARQL under every lens"@en ;
    rdfs:comment "A query (a `.rq` file), or a folder of queries named with a closing slash, meaning every query in it, those added later included, whose `.sql` beside it is compared with the `.rq` over the manifest's fixture under each lens; a query an entry of the manifest runs is compared under that entry's lens without it. A fixture that names the folder `queries/views/` itself, not a view in it or a folder above it, also has the screen each view's `.sql` makes filled keyed to each kind of change and compared with a whole fill."@en .

ctm:boundRecord a owl:ObjectProperty ;
    rdfs:label "bound record"@en ;
    rdfs:comment "A record a matcher query test binds ?record to, as a matcher run binds it to each record it compares; the test's rows are those of every such binding."@en .
