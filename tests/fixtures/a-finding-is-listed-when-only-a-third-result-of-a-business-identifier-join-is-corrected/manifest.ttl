@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-finding-is-listed-when-only-a-third-result-of-a-business-identifier-join-is-corrected" ;
  rdfs:comment "Two chlorides of 98 and 101 at one instant with a finding of their values, and a third chloride of 99 marked as corrected, which the matcher joined to both by a shared business identifier in one judgment." ;
  mf:entries (
    <#listed-for-review>
  ) .

<#listed-for-review> a mf:QueryEvaluationTest ;
  mf:name "listed-for-review" ;
  rdfs:comment "The finding of the two chlorides is listed with its two results: the corrected result is neither of the two it is about, so the join is not certain for them." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <listed-for-review.srj> .
