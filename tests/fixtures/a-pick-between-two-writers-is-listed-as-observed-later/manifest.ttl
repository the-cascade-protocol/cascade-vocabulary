@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-pick-between-two-writers-is-listed-as-observed-later" ;
  rdfs:comment "A condition whose source stamps no change time, pulled by two writers, neither snapshot an ancestor of the other, the other writer's pull observed two days later; and a second condition the same two writers pulled, both observed at one instant." ;
  mf:entries (
    <#the-current-revisions>
    <#what-needs-review>
  ) .

<#the-current-revisions> a mf:QueryEvaluationTest ;
  mf:name "the-current-revisions" ;
  rdfs:comment "The pull observed later is current." ;
  mf:action [ qt:query <the-current-revisions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revisions.tsv> .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "The picks are listed, each with the state shown and the state not shown: the tie, with no basis, and then the pick observed later." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.tsv> .
