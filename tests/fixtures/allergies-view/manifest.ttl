@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "allergies-view" ;
  rdfs:comment "An active allergy entry of two members, the later one entered by the person, stating urticaria and itching, moderate, and no status, and an onset written to the hour, the other anaphylaxis, severe, and an earlier onset; and an inactive allergy, its onset written to the hour; and a dust mite allergy the person entered, stating no status and, for its onset, a reason it holds none." ;
  ctm:comparesSqlWithSparqlUnderEveryLens <../../../queries/views/allergies.rq> ;
  mf:entries (
    <#what-it-shows>
    <#where-it-came-from>
    <#my-active-allergies>
    <#its-padded-onset>
    <#its-type-and-notes>
  ) .

<#its-padded-onset> a mf:QueryEvaluationTest ;
  mf:name "its-padded-onset" ;
  rdfs:comment "An onset its source wrote to the hour keeps, in the view, the node saying so and what was written, on the entry and on its member's values, each named after its holder and -padded-." ;
  mf:action [ qt:query <its-padded-onset.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-padded-onset.tsv> .

<#its-type-and-notes> a mf:QueryEvaluationTest ;
  mf:name "its-type-and-notes" ;
  rdfs:comment "An entry takes the type of its lead alone, the intolerance the person's latex entry states, and shows no note of its members: the peanut entry, whose lead states none, shows no type although the member from the document states an allergy; each member shows its own type and notes, in what-it-shows." ;
  mf:action [ qt:query <its-type-and-notes.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-type-and-notes.tsv> .

<#what-it-shows> a mf:QueryEvaluationTest ;
  mf:name "what-it-shows" ;
  rdfs:comment "Each statement of each allergy entry in its view and each value its members state, with the member that states it and whether that member leads: the allergen, code, reactions and severity from the lead, the category and onset from the lead, else from the member chosen for each, the member the person entered, the other member's allergen, category, onset, reaction and severity beside them, the status from the latest derived from a document, the highest criticality, and each member's type and the notes added to it." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20it%20shows.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-it-shows.tsv> .

<#where-it-came-from> a mf:QueryEvaluationTest ;
  mf:name "where-it-came-from" ;
  rdfs:comment "Each member of each entry: when its current revision arrived, the import or session that brought it, and its document with the hospital that wrote it; the one the person entered has no document." ;
  mf:action [ qt:query <../../../queries/questions/entry/Where%20it%20came%20from.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <where-it-came-from.tsv> .

<#my-active-allergies> a mf:QueryEvaluationTest ;
  mf:name "my-active-allergies" ;
  rdfs:comment "The active entry and the dust mite entry, whose status is not stated, with the code, its highest criticality, the category and the onset of its lead, else of the members chosen for them, its onset written to the hour, what each record it joins states of the reaction (texts, codes, severity), how many records it joins, and each of them with its document, when that was retrieved and the hospital that wrote it; the ones the person entered have none." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20allergies.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-allergies.tsv> .
