@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "lab-results-view" ;
  rdfs:comment "A potassium entry of two members, the earlier written 4.10, the later stating another name, a unit text beside its UCUM unit, and no status and, for its time, a reason it holds none; a glucose at a time, its value and unit as text; a hemoglobin A1c on that day, as a day, below 5.7; a titre 1:64; a urine count of 0 to 5; and an MCV of 101 fL flagged both H and A, its reference range 80-100 fL as text and as two bounds, the high one with a unit text." ;
  ctm:comparesSqlWithSparqlUnderEveryLens <../../../queries/views/lab-results.rq> ;
  mf:entries (
    <#the-lab-results-view>
    <#the-reference-range-bounds>
    <#what-it-shows>
    <#my-lab-results>
  ) .

<#the-lab-results-view> a mf:QueryEvaluationTest ;
  mf:name "the-lab-results-view" ;
  rdfs:comment "Each entry takes the test, code, value, unit and time of its lead, so the potassium shows no time and its unit text, and the status of the member chosen for status; a bound shows its comparator, a ratio its two parts and a range its two bounds. The MCV shows both flags its source gave, as codes, and its reference range's text and bounds; the potassium shows its lead's code in another system, never the earlier member's." ;
  mf:action [ qt:query <the-lab-results-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-lab-results-view.tsv> .

<#the-reference-range-bounds> a mf:QueryEvaluationTest ;
  mf:name "the-reference-range-bounds" ;
  rdfs:comment "Each bound of the MCV's reference range is a node of the view holding its lead's number as typed and as written and its units, so an app reads the range from the view alone." ;
  mf:action [ qt:query <the-reference-range-bounds.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-reference-range-bounds.tsv> .

<#what-it-shows> a mf:QueryEvaluationTest ;
  mf:name "what-it-shows" ;
  rdfs:comment "The MCV's reference range is shown by its text and by each bound, a node of its own that the member's values name by the link, each of its values a row with the member and its Part, `referenceRangeLow` or `referenceRangeHigh`; the entry's own bound nodes repeat the member's and are not shown. Each member's own code in another system and the note added to it are rows of that member, and the later potassium member's reason for holding no time is the rows of a node of its own, with the Part `valueAbsentForReason resultClinicallyRelevantTime`." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20it%20shows.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-it-shows.tsv> .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "Every entry, newest first by day and then by time as written, so the glucose comes before the A1c of its day, with how many records it joins and each of them, none from a document; the MCV with both its flags, as codes, its reference range's text, and each bound as written with its unit, the high one's unit text before its UCUM unit." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20lab%20results.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.tsv> .
