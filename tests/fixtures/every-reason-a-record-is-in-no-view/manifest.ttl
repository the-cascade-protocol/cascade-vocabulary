@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "every-reason-a-record-is-in-no-view" ;
  rdfs:comment "One record for each reason the derivations leave a record out, a patient profile judged not about the subject by one person and about it by another among them, an immunization, a lab result, a procedure, a variant and a variant interpretation their source marks entered in error by their status, one whose current version names no patient, and two records that are shown, one a medication its source marks entered in error by its status, which its lifecycle says." ;
  mf:entries (
    <#why-it-is-in-no-view>
    <#the-records-left-out-for-their-patient>
  ) .

<#why-it-is-in-no-view> a mf:QueryEvaluationTest ;
  mf:name "why-it-is-in-no-view" ;
  rdfs:comment "One row for each record left out, with its reason and what the reason rests on; the record shown has none." ;
  mf:action [ qt:query <../../../queries/questions/record/Why%20it%20is%20in%20no%20view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <why-it-is-in-no-view.tsv> .

<#the-records-left-out-for-their-patient> a mf:QueryEvaluationTest ;
  mf:name "the-records-left-out-for-their-patient" ;
  rdfs:comment "A record with no patient, one whose patient profile no counting About ties to the subject, one whose profile a counting NotAbout names, and one held back by a NotAbout against a person's About, each with its reason and the profile it rests on; no other reason." ;
  mf:action [ qt:query <the-records-left-out-for-their-patient.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-records-left-out-for-their-patient.tsv> .
