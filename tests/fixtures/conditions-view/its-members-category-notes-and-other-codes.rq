PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT ?member ?field ?value
WHERE {
  GRAPH <https://pod.example/clinical/conditions.ttl> {
    ?values cascade:valuesOfMember ?member ; ?field ?value
    FILTER (?field IN (cascade:conditionCategory, cascade:conditionCodeInOtherSystem, cascade:addedNoteText))
  }
}
