@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-about-for-another-subject-stands-against-no-not-about" ;
  rdfs:comment "Over one profile, a parent's About for one subject and another parent's NotAbout for the other." ;
  mf:entries (
    <#what-needs-review>
    <#whose-it-is-counted-as>
    <#the-person-this-pod-is-about>
  ) .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "No profile is listed: the About is answered and does not stand against a NotAbout for another subject." ;
  mf:action [ qt:query <../../../queries/questions/profile/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.tsv> .

<#whose-it-is-counted-as> a mf:QueryEvaluationTest ;
  mf:name "whose-it-is-counted-as" ;
  rdfs:comment "The About counts: a NotAbout for another subject outranks it not at all." ;
  mf:action [ qt:query <../../../queries/questions/profile/Whose%20it%20is%20counted%20as.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <whose-it-is-counted-as.tsv> .

<#the-person-this-pod-is-about> a mf:QueryEvaluationTest ;
  mf:name "the-person-this-pod-is-about" ;
  rdfs:comment "A row for each subject, in the order of their names: the one the About names, with the profile it claims and no value of its own; the other, nothing claims." ;
  mf:action [ qt:query <../../../queries/questions/pod/The%20person%20this%20pod%20is%20about.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-person-this-pod-is-about.tsv> .
