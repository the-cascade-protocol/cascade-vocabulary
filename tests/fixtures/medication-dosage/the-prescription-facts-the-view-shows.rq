PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT DISTINCT ?member ?field ?value
WHERE { GRAPH <https://pod.example/clinical/medications.ttl> {
  ?entry cascade:entryMember [] ; cascade:memberCurrentValues ?values .
  ?values cascade:valuesOfMember ?member ; ?field ?value
  FILTER (?field IN (cascade:medicationRequestIntent, cascade:courseOfTherapyType, cascade:dispenseRequestValidityPeriodEnd)) } }
