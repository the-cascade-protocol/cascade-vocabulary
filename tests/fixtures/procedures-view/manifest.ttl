@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "procedures-view" ;
  rdfs:comment "A procedure entry of two members, the later naming it, stating no status and no date and its SNOMED CT code; and one not done." ;
  mf:entries (
    <#the-procedures-view>
    <#my-procedures>
    <#its-members-other-codes>
  ) .

<#its-members-other-codes> a mf:QueryEvaluationTest ;
  mf:name "its-members-other-codes" ;
  rdfs:comment "Each member's current values state the codes it gives in other systems; the entry takes only its lead's, so the earlier member's code is the member's alone." ;
  mf:action [ qt:query <its-members-other-codes.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-members-other-codes.tsv> .

<#the-procedures-view> a mf:QueryEvaluationTest ;
  mf:name "the-procedures-view" ;
  rdfs:comment "Each entry takes the name and code of its lead, the status of the member chosen for status, and the date of the member chosen for the date." ;
  mf:action [ qt:query <the-procedures-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-procedures-view.tsv> .

<#my-procedures> a mf:QueryEvaluationTest ;
  mf:name "my-procedures" ;
  rdfs:comment "Every entry, newest first, with its code as SNOMED CT's IRI and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20procedures.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-procedures.tsv> .
