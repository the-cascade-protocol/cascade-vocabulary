@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-finding-of-two-results-joined-by-a-shared-business-identifier-is-not-listed-when-one-is-amended" ;
  rdfs:comment "Two sodiums of 139 and 141 at one instant with a finding of their values, which the matcher joined by a shared business identifier, the second marked as amended." ;
  mf:entries (
    <#listed-for-review>
  ) .

<#listed-for-review> a mf:QueryEvaluationTest ;
  mf:name "listed-for-review" ;
  rdfs:comment "Nothing is listed: the finding of the two sodiums is not, since a shared business identifier with one of the two amended is certain." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <listed-for-review.srj> .
