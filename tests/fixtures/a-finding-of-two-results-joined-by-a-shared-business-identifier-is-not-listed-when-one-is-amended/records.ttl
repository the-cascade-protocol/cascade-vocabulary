    cascade:workflowStatus "amended" ;
    cascade:testCode <http://loinc.org/rdf/2951-2> ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:identifiedAmendedVersion#value> .
<urn:x:identifiedAmendedVersion#value> cascade:decimalValue "141"^^xsd:decimal ; cascade:writtenValue "141" ; cascade:ucumUnit "mmol/L" .
