:subject a cascade:Subject .

:identifiedFirst a cascade:LaboratoryTestResult .
<urn:x:identifiedFirstVersion> prov:specializationOf :identifiedFirst ; cascade:patient :subject ; cascade:testName "Sodium" ;
    cascade:testCode <http://loinc.org/rdf/2951-2> ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:identifiedFirstVersion#value> .
<urn:x:identifiedFirstVersion#value> cascade:decimalValue "139"^^xsd:decimal ; cascade:writtenValue "139" ; cascade:ucumUnit "mmol/L" .
:identifiedFirstRevision a cascade:Revision ; cascade:revisionOf :identifiedFirst ; cascade:version <urn:x:identifiedFirstVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:identifiedAmended a cascade:LaboratoryTestResult .
