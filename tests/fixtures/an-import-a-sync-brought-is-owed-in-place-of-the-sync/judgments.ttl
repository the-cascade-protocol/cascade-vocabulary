@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:owner a prov:Person .

:about a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :profile ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :owner ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :owner ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-03T08:00:00Z"^^xsd:dateTime .
